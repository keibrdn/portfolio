# Copy this file to `.env` in the same folder (frontend/).
# Vite only exposes variables prefixed with VITE_.

VITE_SANITY_PROJECT_ID=yourProjectId
VITE_SANITY_DATASET=production
# Production: add https://your-domain.com (exact origin, no trailing slash) under
# sanity.io/manage → your project → API → CORS origins, or the browser blocks queries.

# Optional: set to false in prod builds to use api.sanity.io instead of apicdn.sanity.io.
# VITE_SANITY_USE_CDN=false

# Optional: set to false to call Sanity directly in dev (requires CORS origins in sanity.io/manage).
# VITE_SANITY_USE_PROXY=false

# Optional — home hero social links (mailto + full URLs).
# VITE_CONTACT_EMAIL=
# VITE_SOCIAL_LINKEDIN=
# VITE_SOCIAL_X=
